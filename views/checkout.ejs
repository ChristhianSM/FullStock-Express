<script type="module">
  import { setupValidation } from "/js/form-validation.js";
  import { orderSchema } from "/js/shared/orderSchema.js";

  const formCheckout = document.querySelector("[data-js='form-checkout']");
  setupValidation(formCheckout, orderSchema);
</script>

<% 
  const countries = [
    { code: 'AR', name: 'Argentina' },
    { code: 'BO', name: 'Bolivia' },
    { code: 'CL', name: 'Chile' },
    { code: 'CO', name: 'Colombia' },
    { code: 'CR', name: 'Costa Rica' },
    { code: 'CU', name: 'Cuba' },
    { code: 'DO', name: 'República Dominicana' },
    { code: 'EC', name: 'Ecuador' },
    { code: 'SV', name: 'El Salvador' },
    { code: 'GT', name: 'Guatemala' },
    { code: 'HN', name: 'Honduras' },
    { code: 'MX', name: 'México' },
    { code: 'NI', name: 'Nicaragua' },
    { code: 'PA', name: 'Panamá' },
    { code: 'PY', name: 'Paraguay' },
    { code: 'PE', name: 'Perú' },
    { code: 'PR', name: 'Puerto Rico' },
    { code: 'UY', name: 'Uruguay' },
    { code: 'VE', name: 'Venezuela' },
  ]
%>

<section class="section checkout">
  <div class="container">
    <div class="checkout__layout">
      <div class="checkout__summary">
        <h2 class="checkout__summary_title">Resumen de la orden</h2>
        <div class="checkout__summary_container">
          <% for(const item of cartItems) { %>
          <div class="checkout__item">
            <div class="checkout__item-image">
              <img
                src="<%= item.product.imgSrc %>"
                alt="<%= item.product.name %>"
                class="checkout__item-image-content"
              />
            </div>
            <div class="checkout__item-details">
              <h3 class="checkout__item-title"><%= item.product.name %></h3>
              <div class="checkout__item-price">
                <p><%= item.quantity %></p>
                <img
                  src="/images/icons/x.svg"
                  alt=""
                  class="checkout__item-price-icon"
                />
                <p>S/ <%= (item.product.price / 100).toFixed(2) %></p>
              </div>
            </div>
          </div>
          <% } %>
          <div class="checkout__total">
            <p>Total</p>
            <p><%= total.toFixed(2) %></p>
          </div>
        </div>
      </div>
      <form class="checkout__form" action="/checkout/place-order" method="post" data-js='form-checkout'>
        <legend class="checkout__legend">Información de contacto</legend>
        <div class="input-field <%= errors.email ? 'input-field--error' : ''  %>">
          <label for="email">Correo electrónico</label>
          <% if (user) { %>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              value="<%= user.email %>"
              readonly
              required
            />
          <% } else { %>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              value="<%= values.email || "" %>"
              required
            />

            <% if (errors.email) { %>
              <span class="input-field__error"><%= errors.email[0] %></span>
            <% } %>
          <% } %>
         
        </div>
        <div class="separator checkout__separator"></div>
        <fieldset>
          <legend class="checkout__legend">Información de envío</legend>
          <div class="checkout__form-fields">
            <div class="input-field <%= errors.firstName ? 'input-field--error' : ''  %>">
              <label for="firstName">Nombre</label>
              <input
                id="firstName"
                name="firstName"
                autocomplete="given-name"
                value="<%= values.firstName || '' %>"
                required
              />
              <% if (errors.firstName) { %>
                <span class="input-field__error"><%= errors.firstName[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.lastName ? 'input-field--error' : ''  %>">
              <label for="lastName">Apellido</label>
              <input
                id="lastName"
                name="lastName"
                autocomplete="family-name"
                required
                value="<%= values.lastName || '' %>"
              />
              <% if (errors.lastName) { %>
                <span class="input-field__error"><%= errors.lastName[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.company ? 'input-field--error' : ''  %>">
              <label for="company">Compañia</label>
              <input 
                id="company" 
                name="company" 
                autocomplete="organization" 
                value="<%= values.company || '' %>"
              />
              <% if (errors.company) { %>
                <span class="input-field__error"><%= errors.company[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.address ? 'input-field--error' : ''  %>">
              <label for="address">Dirección</label>
              <input
                id="address"
                name="address"
                autocomplete="street-address"
                value="<%= values.address || '' %>"
                required
              />
              <% if (errors.address) { %>
                <span class="input-field__error"><%= errors.address[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.city ? 'input-field--error' : ''  %>">
              <label for="city">Ciudad</label>
              <input
                id="city"
                name="city"
                autocomplete="address-level2"
                value="<%= values.city || '' %>"
                required
              />
              <% if (errors.city) { %>
                <span class="input-field__error"><%= errors.city[0] %></span>
              <% } %>
            </div>
            <div class="select-field <%= errors.country ? 'input-field--error' : ''  %>" >
              <label for="country">País</label>
              <select
                id="country"
                name="country"
                autocomplete="country"
                required
              >
                <option value="">Seleccionar país</option>
                <% for(const country of countries) { %>
                  <option value="<%= country.code %>" <%= values.country == country.code ? "selected" : ""%>> <%= country.name %> </option>
                <% } %>
              </select>
              <% if (errors.country) { %>
                <span class="input-field__error"><%= errors.country[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.region ? 'input-field--error' : ''  %>">
              <label for="region">Provincia/Estado</label>
              <input
                id="region"
                name="region"
                autocomplete="address-level1"
                value="<%= values.region || '' %>"
                required
              />
              <% if (errors.region) { %>
                <span class="input-field__error"><%= errors.region[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.zipCode ? 'input-field--error' : ''  %>">
              <label for="zipCode">Código Postal</label>
              <input
                id="zipCode"
                name="zipCode"
                autocomplete="postal-code"
                value="<%= values.zipCode || '' %>"
                required
              />
              <% if (errors.zipCode) { %>
                <span class="input-field__error"><%= errors.zipCode[0] %></span>
              <% } %>
            </div>
            <div class="input-field <%= errors.phone ? 'input-field--error' : ''  %>">
              <label for="phone">Teléfono</label>
              <input 
                id="phone" 
                name="phone" 
                autocomplete="tel" 
                value="<%= values.phone || '' %>" 
                required 
              />
              <% if (errors.phone) { %>
                <span class="input-field__error"><%= errors.phone[0] %></span>
              <% } %>
            </div>
          </div>
        </fieldset>
        <button class="button button--xl checkout__submit">
          Confirmar Orden
        </button>
      </form>
    </div>
  </div>
</section>
