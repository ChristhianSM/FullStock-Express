<!-- views/login.ejs -->
<script src="/js/toggle-password.js" type="module"></script>

<section class="section">
  <div class="container login">
    <h1 class="login__title">Inicia sesión en tu cuenta</h1>

    <!-- El formulario envía los datos vía POST a la ruta /login -->
    <form class="login__form" method="post" action="/auth/login" novalidate>
      <div class="input-field <%= errors.email ? 'input-field--error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          autocomplete="email"
          required
          value="<%= locals.values?.email || '' %>"
        />
        <% if (errors.email) { %>
        <span class="input-field__error"><%= errors.email[0] %></span>
        <% } %>
      </div>
      <div
        class="input-field <%= errors.password ? 'input-field--error' : '' %>"
      >
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          data-toggle-password
          autocomplete="current-password"
          required
        />
        <% if (errors.password) { %>
        <span class="input-field__error"><%= errors.password[0] %></span>
        <% } %>
      </div>
      <button type="submit" class="button button--lg login__submit">
        Iniciar sesión
      </button>

      <!-- Mensaje de error, si existe -->
      <% if (locals.error) { %>
      <p class="login__error"><%= locals.error %></p>
      <% } %>
    </form>
  </div>
</section>
