<script src="/js/toggle-password.js" type="module"></script>

<section class="section">
  <div class="container signup">
    <h1 class="signup__title">Crea una cuenta</h1>
    <form class="signup__form" method="post" action="/auth/signup" novalidate>
      <div class="input-field <%= errors.email ? 'input-field--error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          value="<%= locals.values?.email || ''  %>"
        />
        <% if (errors.email) { %>
        <span class="input-field__error"><%= errors.email[0] %></span>
        <% } %>
      </div>
      <div
        class="input-field <%= errors.password ? 'input-field--error' : '' %>"
      >
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          data-toggle-password
          required
        />
        <% if (errors.password) { %>
        <span class="input-field__error"><%= errors.password[0] %></span>
        <% } %>
      </div>
      <div
        class="input-field <%= errors.confirmPassword ? 'input-field--error' : '' %>"
      >
        <label for="confirm-password">Confirma tu contraseña</label>
        <input
          id="confirm-password"
          name="confirmPassword"
          type="password"
          data-toggle-password
          required
        />
        <% if (errors.confirmPassword) { %>
        <span class="input-field__error"><%= errors.confirmPassword[0] %></span>
        <% } %>
      </div>
      <button type="submit" class="button button--lg signup__submit">
        Crear cuenta
      </button>
    </form>
    <div class="signup__footer">
      <span class="signup__footer_text"> ¿Ya tienes una cuenta? </span>
      <a href="/auth/login" class="signup__footer_link"> Inicia sesión </a>
    </div>
  </div>
  <% if (locals.error) { %>
  <p class="signup__error"><%= locals.error %></p>
  <% } %>
</section>
